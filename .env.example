SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Vazio = SQLite. Para PostgreSQL: postgres://usuario:senha@localhost:5432/portal_aluno
DATABASE_URL=
# Origens do front-end autorizadas (separadas por vírgula). Ex.: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Arquivos privados (fora de qualquer URL pública) e limite de upload
PRIVATE_MEDIA_ROOT=private_media
MAX_UPLOAD_MB=5

# SECTRAS Online (Moodle Web Services). Vazio = integração desativada
MOODLE_BASE_URL=
MOODLE_TOKEN=
INTEGRATION_TIMEOUT=8

# Atalhos exibidos no painel (RF09)
CERBRUM_URL=
SECTRAS_URL=

# (Opcional) trocar o adapter de cada serviço sem alterar código
# GRADES_PROVIDER=integrations.adapters.cerbrum.CerbrumGradesProvider
# COURSES_PROVIDER=integrations.adapters.moodle.MoodleCoursesProvider
# MATERIALS_PROVIDER=integrations.adapters.moodle.MoodleMaterialsProvider
